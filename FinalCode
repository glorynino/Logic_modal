result_label = ttk.Label(result_frame, text="", font=("Arial", 14, "bold"), background="#0e1117")
result_label.pack(pady=5)

# Cadre pour le fond semi-transparent
overlay_frame = None
# Cadre pour l'image
image_frame = None

# Fonction pour fermer l'overlay
def close_overlay(event=None):
    global overlay_frame
    if overlay_frame and overlay_frame.winfo_exists():
        overlay_frame.destroy()
        overlay_frame = None

# Fonction pour afficher/masquer l'image du modèle
def toggle_model_image():
    global overlay_frame, image_frame
    
    # Si l'image est déjà affichée, la masquer
    if overlay_frame and overlay_frame.winfo_exists():
        close_overlay()
        return
    
    # Obtenir l'image pour le modèle sélectionné
    model_type = modele_combo.get()
    image = get_model_image(model_type)
    photo = ImageTk.PhotoImage(image)
    
    # Créer un cadre semi-transparent qui couvre toute la fenêtre
    overlay_frame = tk.Frame(root)
    overlay_frame.place(x=0, y=0, relwidth=1, relheight=1)
    
    # Configurer le fond semi-transparent
    overlay_canvas = tk.Canvas(overlay_frame, highlightthickness=0)
    overlay_canvas.configure(bg="#0e1117")

    overlay_canvas.pack(fill="both", expand=True)
    
    # Créer un rectangle semi-transparent (alpha=50%)
    overlay_canvas.create_rectangle(
    0, 0, root.winfo_width(), root.winfo_height(),
    fill="#0e1117", outline=""
    
)


    
    # Calculer les coordonnées pour centrer l'image
    window_width = root.winfo_width()
    window_height = root.winfo_height()
    image_width, image_height = image.width, image.height
    x_position = (window_width - image_width) // 2
    y_position = (window_height - image_height) // 2
    
    # Créer un cadre blanc pour l'image
    image_frame = tk.Frame(overlay_frame, bg="#0e1117") 
    image_frame.place(x=x_position, y=y_position, width=image_width, height=image_height)
    
    # Créer un label pour afficher l'image
    image_label = tk.Label(image_frame, image=photo, bg="black")
    image_label.image = photo  # Garder une référence pour éviter la garbage collection
    image_label.pack(fill="both", expand=True)
    
    # Configuration améliorée des événements pour fermer l'overlay
    # Cliquer sur le canvas de fond ferme l'overlay
    overlay_canvas.bind("<Button-1>", close_overlay)
    
    # Stopper la propagation du clic sur l'image
    def stop_propagation(event):
        return "break"
    
    # Empêcher la propagation des clics sur l'image et son contenu
    image_frame.bind("<Button-1>", stop_propagation)
    image_label.bind("<Button-1>", stop_propagation)
    
    # Ajouter un bouton de fermeture en haut à droite de l'image
    close_button = ttk.Button(image_frame, text="X", width=3, command=close_overlay)
    close_button.place(x=image_width-30, y=0)

# Actualiser l'image lors du changement de modèle si l'image est affichée
def on_model_change(event):
    if overlay_frame and overlay_frame.winfo_exists():
        close_overlay()  # Fermer l'image actuelle
        root.after(100, toggle_model_image)  # Afficher la nouvelle image après un court délai

modele_combo.bind("<<ComboboxSelected>>", on_model_change)

# S'assurer que la fenêtre est bien affichée avant de tenter d'afficher des overlays
root.update_idletasks()

root.mainloop()