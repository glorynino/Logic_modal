# ------------------- PARSEUR ET ÉVALUATEUR RECURSIF POUR FORMULES MODALES -------------------

# Tokenisation de la formule
def tokenize(formula):
    pattern = r'(□|◇|¬|∧|∨|→|\(|\)|[A-Z])'
    return [token for token in re.findall(pattern, formula) if token.strip() != '']

# Parseur récursif de formules modales
def parse(tokens):
    def parse_primary(index):
        token = tokens[index]

        if token == '(':
            expr, index = parse_expression(index + 1)
            if tokens[index] != ')':
                raise ValueError("Parenthèse fermante attendue")
            return expr, index + 1

        elif token in ('¬', '□', '◇'):
            operand, index = parse_primary(index + 1)
            return (token, operand), index

        elif token in ('A', 'B'):
            return token, index + 1

        raise ValueError(f"Token inattendu : {token}")

    def parse_expression(index):
        left, index = parse_primary(index)

        while index < len(tokens):
            token = tokens[index]
            if token in ('∧', '∨', '→'):
                right, index = parse_primary(index + 1)
                left = (token, left, right)
            else:
                break

        return left, index

    ast, final_index = parse_expression(0)
    if final_index != len(tokens):
        raise ValueError("Formule mal formée")
    return ast


# Évaluation récursive d'un AST
def evaluate(ast, world, model):
    R = model['R']
    V = model['V']

    if isinstance(ast, str):
        return world in V.get(ast, set())

    op = ast[0]

    if op == '¬':
        return not evaluate(ast[1], world, model)
    elif op == '□':
        return all(evaluate(ast[1], w2, model) for w2 in R.get(world, []))
    elif op == '◇':
        return any(evaluate(ast[1], w2, model) for w2 in R.get(world, []))
    elif op == '∧':
        return evaluate(ast[1], world, model) and evaluate(ast[2], world, model)
    elif op == '∨':
        return evaluate(ast[1], world, model) or evaluate(ast[2], world, model)
    elif op == '→':
        return not evaluate(ast[1], world, model) or evaluate(ast[2], world, model)

    return False

# Fonction finale à appeler
def is_true(formula, world, model):
    try:
        tokens = tokenize(formula)
        ast = parse(tokens)
        return evaluate(ast, world, model)
    except Exception as e:
        print(f"Erreur d’analyse ou d’évaluation : {e}")
        return False

    try:
        tokens = tokenize(formula)
        ast = parse(tokens)
        return evaluate(ast, world, model)
    except Exception as e:
        print(f"Erreur d’analyse ou d’évaluation : {e}")
        return False

    R = model['R']
    V = model['V']

    # simplifié, à améliorer avec un vrai parseur récursif
    if formula in V:
        return world in V[formula]
    elif formula.startswith('¬'):
        return not is_true(formula[1:], world, model)
    elif formula.startswith('□'):
        return all(is_true(formula[1:], w2, model) for w2 in R.get(world, []))
    elif formula.startswith('◇'):
        return any(is_true(formula[1:], w2, model) for w2 in R.get(world, []))
    elif '∧' in formula:
        left, right = formula.split('∧', 1)
        return is_true(left, world, model) and is_true(right, world, model)
    elif '∨' in formula:
        left, right = formula.split('∨', 1)
        return is_true(left, world, model) or is_true(right, world, model)
    elif '→' in formula:
        left, right = formula.split('→', 1)
        return not is_true(left, world, model) or is_true(right, world, model)
    return False

