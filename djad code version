# Fonction pour obtenir l'image d'un modèle
def get_model_image(model_type, valuation=None):
    if model_type in model_images and model_images[model_type] and os.path.exists(model_images[model_type]):
        try:
            image = Image.open(model_images[model_type])
            max_size = (800, 600)
            if image.width > max_size[0] or image.height > max_size[1]:
                image.thumbnail(max_size, Image.LANCZOS)
            return image
        except Exception as e:
            print(f"Erreur lors du chargement de l'image pour {model_type}: {e}")
    
    return create_model_image(model_type, valuation)

# Fonction de génération d'image pour les modèles
def create_model_image(model_type, valuation=None):
    width, height = 600, 600
    image = Image.new("RGB", (width, height), "white")
    draw = ImageDraw.Draw(image)

    world_positions = {
        'w0': (width//2, height//4),
        'w1': (width//4, 3*height//4),
        'w2': (3*width//4, 3*height//4)
    }
    
    radius = 30
    for world, pos in world_positions.items():
        draw.ellipse((pos[0]-radius, pos[1]-radius, pos[0]+radius, pos[1]+radius), outline="black", fill="#f0f0f0", width=2)
        draw.text((pos[0]-12, pos[1]-12), world, fill="black", anchor="mm", font=ImageFont.truetype("arial.ttf", 16))
    
    relations = generate_relation(model_type, worlds)
    
    colors = {
        "K": "blue",
        "T": "green",
        "S4": "red",
        "S5": "purple"
    }
    
    arrow_color = colors.get(model_type, "black")
    
    for w1, related_worlds in relations.items():
        start_pos = world_positions[w1]
        for w2 in related_worlds:
            if w1 != w2:
                end_pos = world_positions[w2]
                draw.line([start_pos, end_pos], fill=arrow_color, width=2)
                angle = math.atan2(end_pos[1] - start_pos[1], end_pos[0] - start_pos[0])
                arrow_length = 15
                arrow_x1 = end_pos[0] - arrow_length * math.cos(angle - math.pi/6)
                arrow_y1 = end_pos[1] - arrow_length * math.sin(angle - math.pi/6)
                arrow_x2 = end_pos[0] - arrow_length * math.cos(angle + math.pi/6)
                arrow_y2 = end_pos[1] - arrow_length * math.sin(angle + math.pi/6)
                draw.line([end_pos, (arrow_x1, arrow_y1)], fill=arrow_color, width=2)
                draw.line([end_pos, (arrow_x2, arrow_y2)], fill=arrow_color, width=2)
            
            elif model_type in ["T", "S4", "S5"]:
                reflexive_radius = 10
                draw.arc([start_pos[0]-reflexive_radius, start_pos[1]-2*radius,
                          start_pos[0]+reflexive_radius, start_pos[1]-radius],
                         0, 360, fill=arrow_color, width=2)
    
    model_titles = {
        "K": "Modele K (Pas de restrictions)",
        "T": "Modele T (Reflexif)",
        "S4": "Modele S4 (Reflexif et Transitif)",
        "S5": "Modele S5 (Relation d'equivalence)"
    }
    draw.text((10, 10), model_titles.get(model_type, f"Modèle {model_type}"), fill="black")
    
    if valuation:
        for var, values in valuation.items():
            for world, value in values.items():
                text = f"{var}={1 if value else 0}"
                pos = world_positions[world]
                draw.text((pos[0]+radius+5, pos[1]-12), text, fill="black", anchor="lm", font=ImageFont.truetype("arial.ttf", 12))
    
    return image

