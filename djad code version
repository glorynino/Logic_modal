# ------------------- PARTIE SEMANTIQUE -------------------
def generate_relation(modele, worlds):
    if modele == "K":
        return {w: set(worlds) for w in worlds}
    elif modele == "T":
        return {w: {w} | set(worlds) - {w} for w in worlds}
    elif modele == "S4":
        return {w: {x for x in worlds if worlds.index(x) >= worlds.index(w)} for w in worlds}
    elif modele == "S5":
        return {w: set(worlds) for w in worlds}
    else:
        return {w: set() for w in worlds}

worlds = ['w0', 'w1', 'w2']

# ------------------- PARSEUR ET ÉVALUATEUR RECURSIF POUR FORMULES MODALES -------------------

# Tokenisation de la formule
def tokenize(formula):
    pattern = r'(□|◇|¬|∧|∨|→|⟷|\(|\)|[A-Z])'
    return [token for token in re.findall(pattern, formula) if token.strip() != '']

# Parseur récursif de formules modales
def parse(tokens):
    def parse_primary(index):
        token = tokens[index]
        if token == '(':
            expr, index = parse_expression(index + 1)
            if tokens[index] != ')':
                raise ValueError("Parenthèse fermante attendue")
            return expr, index + 1
        elif token in ('¬', '□', '◇'):
            operand, index = parse_primary(index + 1)
            return (token, operand), index
        elif token in ('A', 'B'):
            return token, index + 1
        raise ValueError(f"Token inattendu : {token}")

    def parse_expression(index):
        left, index = parse_primary(index)
        while index < len(tokens):
            token = tokens[index]
            if token in ('∧', '∨', '→', '⟷'):
                right, index = parse_primary(index + 1)
                left = (token, left, right)
            else:
                break
        return left, index

    ast, final_index = parse_expression(0)
    if final_index != len(tokens):
        raise ValueError("Formule mal formée")
    return ast

# Évaluation récursive d'un AST
def evaluate(ast, world, model, valuation):
    R = model['R']
    if isinstance(ast, str):
        return valuation.get(ast, {}).get(world, False)
    op = ast[0]
    if op == '¬':
        return not evaluate(ast[1], world, model, valuation)
    elif op == '□':
        return all(evaluate(ast[1], w2, model, valuation) for w2 in R.get(world, []))
    elif op == '◇':
        return any(evaluate(ast[1], w2, model, valuation) for w2 in R.get(world, []))
    elif op == '∧':
        return evaluate(ast[1], world, model, valuation) and evaluate(ast[2], world, model, valuation)
    elif op == '∨':
        return evaluate(ast[1], world, model, valuation) or evaluate(ast[2], world, model, valuation)
    elif op == '→':
        return not evaluate(ast[1], world, model, valuation) or evaluate(ast[2], world, model, valuation)
    elif op == '⟷':
        return evaluate(ast[1], world, model, valuation) == evaluate(ast[2], world, model, valuation)
    return False

# Fonction finale à appeler
def is_true(formula, world, model, valuation):
    try:
        tokens = tokenize(formula)
        ast = parse(tokens)
        return evaluate(ast, world, model, valuation)
    except Exception as e:
        print(f"Erreur d'analyse ou d'évaluation : {e}")
        return False

